# See https://help.github.com/articles/ignoring-files/

# dependencies
node_modules/
**/node_modules/

# env
.env
.env.local
.env.*.local
**/.env
!**/.env.example

# build / cache
dist/
build/
coverage/
.expo/
**/.expo/
web-build/
.metro-health-check*
*.tsbuildinfo

# native (generated by expo prebuild)
app/ios/
app/android/

# logs & debug
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# misc
.DS_Store
*.pem
**/*.trace
**/*.zip
**/*.tar.gz
**/*.tgz

# lockfiles (project uses bun in backend)
package-lock.json
**/*.bun

# IDE
.idea/
