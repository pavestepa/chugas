generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  open
  closed
}

enum PostType {
  public
  followers
  community
}

enum PostVisibility {
  public
  followers
  community
}

enum FollowRequestStatus {
  pending
  accepted
  rejected
}

enum CommunityAccess {
  open
  closed
}

enum CommunityMemberRole {
  member
  moderator
  owner
}

enum CommunityRequestStatus {
  pending
  accepted
  rejected
}

enum ConversationType {
  private
  group
}

model User {
  id              String      @id @default(uuid())
  username        String      @unique
  email           String      @unique
  passwordHash    String      @map("password_hash")
  avatarUrl       String      @default("") @map("avatar_url")
  bio             String      @default("")
  followersCount  Int         @default(0) @map("followers_count")
  followingCount  Int         @default(0) @map("following_count")
  accountType     AccountType @default(open) @map("account_type")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  postsAuthored       Post[]              @relation("PostAuthor")
  comments            Comment[]
  likes               PostLike[]
  followers           Follow[]            @relation("Following")
  following           Follow[]            @relation("Follower")
  followRequestsSent  FollowRequest[]     @relation("FollowRequestFollower")
  followRequestsRecv  FollowRequest[]     @relation("FollowRequestFollowing")
  blocksInitiated     UserBlock[]         @relation("Blocker")
  blocksReceived      UserBlock[]         @relation("Blocked")
  communitiesOwned    Community[]         @relation("CommunityOwner")
  communityMembers    CommunityMember[]
  communityRequests   CommunityRequest[]
  communityBans       CommunityBan[]      @relation("BannedUser")
  communityBansGiven  CommunityBan[]      @relation("BannedBy")
  conversationMembers ConversationMember[]
  messagesSent        Message[]
  location            Location?

  @@map("users")
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId, createdAt(sort: Desc)])
  @@index([followingId, createdAt(sort: Desc)])
  @@map("follows")
}

model FollowRequest {
  id          String              @id @default(uuid())
  followerId  String              @map("follower_id")
  followingId String              @map("following_id")
  status      FollowRequestStatus @default(pending)
  createdAt   DateTime            @default(now()) @map("created_at")

  follower  User @relation("FollowRequestFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("FollowRequestFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@index([followingId, status, createdAt(sort: Desc)])
  @@index([followerId, status, createdAt(sort: Desc)])
  @@map("follow_requests")
}

model UserBlock {
  id        String   @id @default(uuid())
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId, createdAt(sort: Desc)])
  @@map("user_blocks")
}

model Community {
  id           String          @id @default(uuid())
  nickname     String          @unique
  title        String
  description  String          @default("")
  bio          String          @default("")
  avatarUrl    String          @default("") @map("avatar_url")
  ownerId      String          @map("owner_id")
  access       CommunityAccess @default(open)
  membersCount Int             @default(0) @map("members_count")
  createdAt    DateTime        @default(now()) @map("created_at")

  owner    User                @relation("CommunityOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members  CommunityMember[]
  requests CommunityRequest[]
  bans     CommunityBan[]
  posts    Post[]

  @@map("communities")
}

model CommunityMember {
  id          String              @id @default(uuid())
  communityId String              @map("community_id")
  userId      String              @map("user_id")
  role        CommunityMemberRole @default(member)
  createdAt   DateTime            @default(now()) @map("created_at")

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@map("community_members")
}

model CommunityRequest {
  id          String                 @id @default(uuid())
  communityId String                 @map("community_id")
  fromUserId  String                 @map("from_user_id")
  status      CommunityRequestStatus @default(pending)
  createdAt   DateTime               @default(now()) @map("created_at")

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  fromUser  User      @relation(fields: [fromUserId], references: [id], onDelete: Cascade)

  @@index([communityId, status, createdAt(sort: Desc)])
  @@map("community_requests")
}

model CommunityBan {
  id          String   @id @default(uuid())
  communityId String   @map("community_id")
  userId      String   @map("user_id")
  bannedById  String   @map("banned_by_id")
  reason      String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation("BannedUser", fields: [userId], references: [id], onDelete: Cascade)
  bannedBy  User      @relation("BannedBy", fields: [bannedById], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([communityId, createdAt(sort: Desc)])
  @@map("community_bans")
}

model Post {
  id          String         @id @default(uuid())
  authorId    String         @map("author_id")
  type        PostType
  visibility  PostVisibility
  communityId String?        @map("community_id")
  text        String
  media       String[]       @default([])
  longitude   Float
  latitude    Float
  expiresAt   DateTime       @map("expires_at")
  createdAt   DateTime       @default(now()) @map("created_at")

  author    User       @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  community Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)
  comments  Comment[]
  likes     PostLike[]

  @@index([authorId, createdAt(sort: Desc)])
  @@index([communityId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@index([longitude, latitude])
  @@map("posts")
}

model Comment {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  authorId  String   @map("author_id")
  text      String
  createdAt DateTime @default(now()) @map("created_at")

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt(sort: Asc)])
  @@map("comments")
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_likes")
}

model Conversation {
  id            String           @id @default(uuid())
  type          ConversationType
  lastMessageAt DateTime         @default(now()) @map("last_message_at")
  createdAt     DateTime         @default(now()) @map("created_at")

  members  ConversationMember[]
  messages Message[]

  @@map("conversations")
}

model ConversationMember {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  userId         String   @map("user_id")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  senderId       String   @map("sender_id")
  text           String
  attachments    Json     @default("[]")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("messages")
}

model Location {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  longitude Float
  latitude  Float
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([longitude, latitude])
  @@map("locations")
}
