{
  "name": "chugas-monorepo",
  "private": true,
  "scripts": {
    "dev:backend": "npm run dev --prefix backend",
    "dev:app": "npm run dev --prefix app",
    "docker:up": "npm run docker:up --prefix backend",
    "docker:down": "npm run docker:down --prefix backend",
    "setup": "npm run docker:up --prefix backend && sleep 3 && npm run prisma:deploy --prefix backend && npm run seed:default-user --prefix backend",
    "seed:default-user": "npm run seed:default-user --prefix backend",
    "postman:types": "python3 backend/scripts/enrich-postman-types.py",
    "typecheck": "npm run typecheck:backend && npm run typecheck:app",
    "typecheck:backend": "npm run typecheck --prefix backend",
    "typecheck:app": "npm run typecheck --prefix app",
    "lint:backend": "npm run lint --prefix backend",
    "lint:app": "npm run lint --prefix app"
  }
}
